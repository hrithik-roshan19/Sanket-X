# Backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/data/raw_uploads/*
backend/data/canonical/*
backend/data/models/*
!backend/data/raw_uploads/.gitkeep
!backend/data/canonical/.gitkeep
!backend/data/models/.gitkeep
backend/.env

# Live ingestion (Phase 6): fetched cycles and observation pulls are reproducible from
# app/live/ against the public NOAA and Open-Meteo endpoints, so the CSVs are build
# output, not source. Same for the scratch dir GRIB messages are decoded in.
backend/data/live/
backend/data/_live_scratch/

# Timestamped safety copies written by scripts/fix_forecast_valid_date_offset.py before
# it rewrites partitions in place.
backend/data/canonical_backup_*/

# Sample data: keep the compact parquet + the fetch scripts as source of truth,
# ignore the bulky CSV mirrors and the fetch checkpoint dir.
backend/data/samples/*.csv
backend/data/samples/_gefs_parts/
# Backfilled years are large and only 2019 is needed by the tests, which regenerate its
# CSV twin from it. Keep 2019 tracked; leave the rest to the backfill workflow's artifact.
backend/data/samples/gefs_reforecast_india_*.parquet
!backend/data/samples/gefs_reforecast_india_2019.parquet
backend/data/samples/era5_observations_india_*.parquet
!backend/data/samples/era5_observations_india_2019.parquet
# regenerate with scripts/compare_verification_products.py; the numbers live in HANDOFF
backend/data/analysis/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
# incremental-build cache: machine-specific, churns on every build
frontend/tsconfig.tsbuildinfo

# OS / editor
.DS_Store
*.swp
backend/app/static/

# Session handoff notes: internal strategy, kept out of the public repo.
HANDOFF.md

# Generated beside the canonical store by the packaging step.
backend/data/summary.json

# Regenerated by scripts/run_baselines.py against a specific model run. Not committed
# until CI produces it for the run that is actually deployed - a results file naming a
# superseded run is worse than no results file.
docs/results.md

# Local editor/agent tooling config. Machine-specific (it carries absolute paths from
# whoever generated it) and of no use to anyone cloning this, so it is not published.
.claude/
