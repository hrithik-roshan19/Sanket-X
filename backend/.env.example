        # Copy to .env and adjust as needed. All paths are relative to backend/ unless absolute.

DATA_DIR=data
DB_PATH=metadata.db
MODEL_DIR=data/models
RAW_UPLOAD_DIR=data/raw_uploads
CANONICAL_DIR=data/canonical
GEO_DIR=data/geo

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Phase 6: live ingestion -------------------------------------------------------
# Off by default. When true, a background thread pulls each published GEFS cycle and
# refreshes observations. Nothing reaches out to NOAA unless this is on.
LIVE_INGEST_ENABLED=false
LIVE_GEFS_CYCLES=00,06,12,18
# Hours after issue time before a cycle is considered published (GEFS takes ~4-5 h).
LIVE_GEFS_PUBLISH_LAG_HOURS=5.5
# Must stay at these five: the models were trained on a 5-member ensemble and the
# spread features would be biased by a wider set. See app/live/README.md.
LIVE_GEFS_MEMBERS=gec00,gep01,gep02,gep03,gep04
LIVE_DOWNLOAD_WORKERS=20
LIVE_OBS_PROVISIONAL_DAYS=14
LIVE_OBS_FINAL_DAYS=21
LIVE_RETRAIN_MIN_NEW_ROWS=500

# M11 serving hardening
UPLOAD_ENABLED=true
ADMIN_API_KEY=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=30
METRICS_ENABLED=true
