# Keep the build context small and the image reproducible. Anything regenerated by the
# build, or supplied by the release asset, must not be copied in from a developer's
# machine - otherwise a local model silently ships instead of the published one.

**/node_modules
**/.venv
**/__pycache__
**/*.pyc
.git
.github

# Build output (stage 1 regenerates it)
frontend/dist

# Local state: the release asset provides these in the image
backend/data/canonical
backend/data/models
backend/data/raw_uploads
backend/data/live
backend/data/_live_scratch
backend/data/canonical_backup_*
backend/*.db

# Bulky sample mirrors; the committed parquet is the source of truth
backend/data/samples/*.csv
backend/data/samples/_gefs_parts

# Docs and dev-only files
*.md
!backend/scripts/README.md
.vscode
.idea
.DS_Store
